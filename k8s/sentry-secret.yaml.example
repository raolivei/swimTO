# Sentry Secret for swimTO
# Copy this file to sentry-secret.yaml and fill in your Sentry DSN
#
# To get a Sentry DSN:
# 1. Create an account at https://sentry.io
# 2. Create a new project (Python/FastAPI)
# 3. Copy the DSN from Project Settings > Client Keys
#
# Apply with: kubectl apply -f k8s/sentry-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: sentry-credentials
  namespace: swimto
type: Opaque
stringData:
  SENTRY_DSN: "https://your-key@sentry.io/your-project-id"
